# ==============================================================================
# UNDERSTUDY - WEB UI (docker-compose.yml service "understudy-frontend", port 3000)
# Next.js 16 + React 19 + Tailwind CSS 4: Studio (/wizard) and Mission Control (/)
# The browser calls the backend at http://localhost:8000 (set NEXT_PUBLIC_UNDERSTUDY_API_BASE at build time to change it).
# ==============================================================================
FROM node:24-alpine AS builder

WORKDIR /app

# Install dependencies (exactly the lock file)
COPY understudy-ui/package*.json ./
RUN npm ci --no-audit --no-fund

# Copy frontend source code
COPY understudy-ui/ ./

# Disable Next.js telemetry during build
ARG NEXT_PUBLIC_UNDERSTUDY_API_BASE=
ENV NEXT_PUBLIC_UNDERSTUDY_API_BASE=$NEXT_PUBLIC_UNDERSTUDY_API_BASE
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build production Next.js bundle
RUN npm run build

# Runner stage
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
