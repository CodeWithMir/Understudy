# Copy to .env (never commit .env) - setup.sh / setup.bat do it for you. All values are optional:
# with no key (and no Vertex AI), Understudy runs in offline LOCAL_HEURISTIC mode; with a key, the AI agents run.
# Real environment variables (Docker, Cloud Run, the shell) win over this file.
# Get a free key at https://aistudio.google.com/apikey  -- paste it after the "=" (no quotes needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Accounts and access - all optional ---
# Mission Control login. Leave the password empty: the first start generates a unique one, saves it here and shows it
# once (show it again: python scripts/admin_password.py show). Every start reuses it - the same as Cloud Run (Secret
# Manager). A password changed in Mission Control lasts until the next restart. New one: python scripts/admin_password.py reset
UNDERSTUDY_ADMIN_USERNAME=
UNDERSTUDY_ADMIN_PASSWORD=
# Optional static API token (X-Admin-Token) for scripts/CI calling /api/admin without logging in.
UNDERSTUDY_ADMIN_TOKEN=
# Studio users (7.0): required = every developer logs in with an account the admin created in Mission Control > Users
# | off = single-user local mode (no login; projects and sessions have no owner)
UNDERSTUDY_USER_LOGIN=required
# Self-signup (8.1): on = people can create their own Studio account (email verified with a 6-digit code) | off.
# Only the default: Mission Control > Users > "Allow self-signup" overrides it at runtime.
UNDERSTUDY_SIGNUP=on
# 8.2: only these email domains may self-sign-up (comma separated, *.acme.com = subdomains); empty = any domain.
# Mission Control > Users > Self-signup email domains wins over this default.
# UNDERSTUDY_SIGNUP_DOMAINS=companyname.com

# --- Email (8.1): OTP codes for signup / password reset, and account notices (block, unblock, delete) ---
# Free options - README section 2.0.2:
#   Gmail:   UNDERSTUDY_SMTP_HOST=smtp.gmail.com  PORT=587  SECURITY=starttls  USER=you@gmail.com  PASSWORD=<16-char App Password>
#   Brevo:   UNDERSTUDY_SMTP_HOST=smtp-relay.brevo.com  PORT=587  USER=<your Brevo SMTP login>  PASSWORD=<SMTP key>
#   (Outlook.com personal accounts no longer accept password SMTP - use Gmail or Brevo)
# Without UNDERSTUDY_SMTP_HOST the mode is "outbox": mails go to generated/mail/outbox.jsonl on the server
# (development only; read them with: python scripts/mail_outbox.py). The password stays in this file only.
UNDERSTUDY_MAIL_MODE=
UNDERSTUDY_SMTP_HOST=
UNDERSTUDY_SMTP_PORT=587
UNDERSTUDY_SMTP_SECURITY=starttls
UNDERSTUDY_SMTP_USER=
UNDERSTUDY_SMTP_PASSWORD=
UNDERSTUDY_MAIL_FROM=
UNDERSTUDY_MAIL_FROM_NAME=Understudy
# Shown in "blocked" / "deleted" mails as the address users should contact (default: UNDERSTUDY_MAIL_FROM)
UNDERSTUDY_ADMIN_CONTACT=
# Page discovery: auto = render JavaScript-built pages (React/Angular/Vue...) in headless Chromium | always | never
UNDERSTUDY_DISCOVERY_RENDER=auto
# Self-healing: ask = the user reviews and approves every fix (default) | automatic. The Mission Control switch wins.
UNDERSTUDY_SELF_HEAL_APPROVAL=ask
# auto = install framework dependencies on demand | dry-run = plan only | off
UNDERSTUDY_DEPENDENCY_INSTALL=auto
# Mission Control telemetry log (JSONL) and max characters kept per field (prompts / responses)
UNDERSTUDY_ACTIVITY_LOG=
UNDERSTUDY_TELEMETRY_MAX_CHARS=60000
# Docker build only: true adds Java + Maven so users can run Java tools (REST Assured)
UNDERSTUDY_INSTALL_JAVA=false
# Private/internal targets are normally approved in Mission Control (URL exception list; Portal 1/2 by default).
# This is an optional extra operator-level allow-list. Cloud-metadata addresses are always blocked.
UNDERSTUDY_ALLOWED_PRIVATE_HOSTS=
UNDERSTUDY_ALLOW_PRIVATE_NETWORKS=false
# Automatic self-healing retries per run (1-50, default 5). Admins change it in Mission Control.
UNDERSTUDY_MAX_SELF_HEAL_RETRIES=5
# Restricted network for automation runs: restricted (target + admin allowed list only) | public (any public host).
# The admin blocked list, cloud metadata and private ranges are denied in both modes. Also switchable in Mission Control.
UNDERSTUDY_NETWORK_MODE=restricted
UNDERSTUDY_EGRESS=on
# Optional Google Cloud Model Armor template screened in front of the built-in guardrails (uses ADC, no key):
# UNDERSTUDY_MODEL_ARMOR_TEMPLATE=projects/<project>/locations/<region>/templates/<template>
# UNDERSTUDY_MODEL_ARMOR_FAIL_CLOSED=false
# Learned skills folder (lessons from real errors, SKILL.md files). Default: ./skills
UNDERSTUDY_SKILLS_DIR=
# Code health: scan start-up warnings (on/off) and apply verified AI fixes automatically (default false = admin approves)
UNDERSTUDY_CODE_HEALTH=on
UNDERSTUDY_CODE_HEALTH_AUTO_APPLY=false
# Largest recording accepted in Step 1 (MB)
UNDERSTUDY_MAX_MEDIA_MB=250

# --- Advanced operator settings (defaults shown; most are also switchable in Mission Control) ---
# Tools approved on a fresh install: none (the admin adds each with the AI setup) | playwright | catalog
# UNDERSTUDY_DEFAULT_TOOLS=none
# Setup repair agent for failed tool setups (on/off) and the stronger model it offers the admin
# UNDERSTUDY_SETUP_AGENT=on
# UNDERSTUDY_SETUP_AGENT_MODEL=gemini-pro-latest
# AI fixes for failed tool setups: ask (the admin approves) | automatic
# UNDERSTUDY_SETUP_FIX_APPROVAL=ask
# Build agent rounds (Gemini rewrites the suite until its locators pass on fresh page loads)
# UNDERSTUDY_BUILD_AGENT_ROUNDS=3
# Live page probe before code is written (on/off)
# UNDERSTUDY_PAGE_PROBE=on
# Re-use learned AI answers when the AI is unavailable (on/off)
# UNDERSTUDY_RECALL=on
# Switch every AI call off (built-in rules and learned skills only)
# UNDERSTUDY_FORCE_HEURISTIC=0
# Time limits: one automation run / one dependency install (seconds)
# UNDERSTUDY_RUN_TIMEOUT_S=300
# UNDERSTUDY_INSTALL_TIMEOUT_S=900

# --- Google Cloud (optional) ---
# Easiest: run  ./scripts/gcp_setup.sh <project-id>  (Windows: scripts\gcp_setup.bat <project-id>) - it fills these in.
# Step-by-step guide: README > "Google Cloud set-up, step by step". deploy_cloudrun.sh sets them on Cloud Run.
# Gemini on Vertex AI with Application Default Credentials (gcloud auth application-default login / service account):
# no API key needed.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Optional Vertex AI tuning: a different location for AI calls only (e.g. global), a fixed model, the fallback model
UNDERSTUDY_VERTEX_LOCATION=
UNDERSTUDY_VERTEX_MODEL=
UNDERSTUDY_VERTEX_FALLBACK_MODEL=gemini-2.5-flash
# Service-account key file instead of `gcloud auth application-default login` (keep it OUTSIDE this folder)
GOOGLE_APPLICATION_CREDENTIALS=
# Durable state: local (generated/store) | firestore (shared by every instance; pip install -r requirements-gcp.txt)
UNDERSTUDY_STORE=local
UNDERSTUDY_FIRESTORE_DATABASE=(default)
UNDERSTUDY_FIRESTORE_PREFIX=understudy_
# Recordings in Cloud Storage (Vertex AI reads gs:// - required there for videos over 18 MB)
UNDERSTUDY_GCS_BUCKET=
# Pin the admin-token signing secret (e.g. from Secret Manager); default: random per start / shared via Firestore
UNDERSTUDY_SESSION_SECRET=
