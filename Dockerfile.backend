# ==============================================================================
# UNDERSTUDY - BACKEND (docker-compose.yml service "understudy-backend", port 8000)
# Python 3.11 + FastAPI + demo ERP portals + Playwright Chromium + Node.js 24 LTS
# Node.js lets users run the JavaScript tools (Cypress, Playwright JS, Puppeteer, WebdriverIO).
# Build with --build-arg INSTALL_JAVA=true to preinstall Java + Maven (Understudy can also download them itself).
# ==============================================================================
FROM python:3.11-slim
ARG INSTALL_JAVA=false

# Prevent Python from writing .pyc and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Install system dependencies for Playwright & networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    gnupg \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    xvfb \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && if [ "$INSTALL_JAVA" = "true" ]; then apt-get install -y --no-install-recommends default-jdk-headless maven; fi \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt requirements-gcp.txt ./
# requirements-gcp.txt = requirements.txt + Firestore / Cloud Storage clients (used only when configured)
RUN pip install --no-cache-dir -r requirements-gcp.txt

# Install Playwright browser binaries
RUN python -m playwright install --with-deps chromium

# Copy application source (the web UI is served by its own image, Dockerfile.frontend; its package files stay here
# for Mission Control > Code health's dependency checks)
COPY . .
RUN mkdir -p /app/generated /app/uploads /app/skills

# Expose backend port
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 CMD curl -fs http://127.0.0.1:8000/api/health || exit 1

# Launch FastAPI / Uvicorn server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
